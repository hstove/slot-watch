{
  "name": "slot-watch",
  "module": "src/run.ts",
  "type": "module",
  "scripts": {
    "dev:client": "turbo dev --filter=slot-watch-ui",
    "build:common": "turbo build --filter=slot-watch-common",
    "build:client": "turbo build --filter=slot-watch-ui",
    "build": "turbo build",
    "build:packages": "turbo build --filter=slot-watch-common",
    "dev:server": "cd server && bun run start",
    "migrate": "cd server && bun run migrate.ts",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.2",
    "@flydotio/dockerfile": "latest",
    "shadcn": "^2.1.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.2"
  },
  "peerDependencies": {},
  "dependencies": {
    "usehooks-ts": "^3.1.0"
  },
  "workspaces": [
    "./client",
    "./common",
    "./server"
  ],
  "packageManager": "bun@1.0.22"
}
