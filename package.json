{
  "name": "slot-watch",
  "module": "src/run.ts",
  "type": "module",
  "scripts": {
    "dev:client": "bun run --cwd client dev:tee",
    "dev:client:tee": "turbo dev:tee --filter=slot-watch-ui",
    "build:client": "turbo build --filter=slot-watch-ui",
    "build:server": "turbo build --filter=slot-watch-api",
    "dev:server": "cd server && bun run dev:watch",
    "dev:worker": "cd server && bun run worker",
    "migrate": "bun run --cwd server --bun --env-file=../.env.local migrate",
    "typecheck": "turbo typecheck",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "check:all": "bun check:fix && bun typecheck",
    "dev": "turbo dev --filter=slot-watch-ui",
    "deploy:alchemy": "bun alchemy deploy --env-file .env.local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@flydotio/dockerfile": "latest",
    "@total-typescript/tsconfig": "^1.0.4",
    "@typescript/native-preview": "^7.0.0-dev.20260102.1",
    "shadcn": "^2.1.0",
    "tsdown": "^0.14.1",
    "tsx": "^4.19.1",
    "ultracite": "^6.5.0"
  },
  "peerDependencies": {},
  "dependencies": {
    "@stacks/transactions": "^7.0.2",
    "alchemy": "^0.82.2",
    "arktype": "^2.1.29",
    "caniuse-lite": "^1.0.30001720",
    "superjson": "^2.2.1",
    "turbo": "^2.7.2",
    "usehooks-ts": "^3.1.0"
  },
  "workspaces": [
    "./client",
    "./common",
    "./server",
    "./streamer"
  ],
  "packageManager": "bun@1.0.22",
  "resolutions": {
    "whatwg-url": "^14.0.0"
  },
  "overrides": {
    "whatwg-url": "^14.0.0",
    "libsodium-wrappers": "0.7.15"
  }
}
