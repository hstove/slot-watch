{
  "name": "slot-watch",
  "module": "src/run.ts",
  "type": "module",
  "scripts": {
    "dev:client": "turbo dev --filter=slot-watch-ui",
    "build:common": "turbo build --filter=slot-watch-common",
    "build:client": "turbo build --filter=slot-watch-ui",
    "build:server": "turbo build --filter=slot-watch-api",
    "build": "turbo build",
    "build:packages": "turbo build --filter=slot-watch-common",
    "dev:server": "cd server && bun run dev:watch",
    "dev:common": "cd common && bun run dev",
    "dev:worker": "cd server && bun run worker",
    "migrate": "cd server && bun run migrate.ts",
    "typecheck": "turbo typecheck",
    "dev": "turbo dev --filter=slot-watch-common --filter=slot-watch-ui",
    "deploy:alchemy": "bun alchemy deploy --env-file .env.local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@flydotio/dockerfile": "latest",
    "shadcn": "^2.1.0",
    "tsdown": "^0.14.1",
    "tsx": "^4.19.1",
    "ultracite": "^6.5.0"
  },
  "peerDependencies": {},
  "dependencies": {
    "@stacks/transactions": "^7.0.2",
    "alchemy": "^0.62.2",
    "caniuse-lite": "^1.0.30001720",
    "superjson": "^2.2.1",
    "turbo": "^2.5.6",
    "usehooks-ts": "^3.1.0"
  },
  "workspaces": [
    "./client",
    "./common",
    "./server",
    "./streamer"
  ],
  "packageManager": "bun@1.0.22",
  "resolutions": {
    "whatwg-url": "^14.0.0"
  },
  "overrides": {
    "whatwg-url": "^14.0.0"
  }
}
