{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {}
  }
}
