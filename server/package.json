{
  "name": "slot-watch-api",
  "module": "src/run.ts",
  "type": "module",
  "exports": {
    ".": "./dist/exports.js"
  },
  "types": "./dist/exports.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "dev:watch": "bun --watch src/app.ts",
    "build": "tsup",
    "start": "bun src/app.ts",
    "typecheck": "tsc --noEmit",
    "generate-migrations": "drizzle-kit generate",
    "migrate": "bun migrate.ts",
    "test:watch": "vitest",
    "worker": "bun run src/worker/worker.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.27.0",
    "ts-toolbelt": "^9.6.0",
    "tsx": "^4.19.1"
  },
  "peerDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@clarigen/core": "^2.1.2",
    "@hono/zod-validator": "^0.4.1",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.9",
    "@stacks/common": "^7.0.2",
    "@stacks/stacks-blockchain-api-types": "^7.14.1",
    "@stacks/transactions": "^7.0.2",
    "@stricjs/app": "^1.0.0-rc.34",
    "@stricjs/utils": "^2.0.7",
    "bullmq": "^5.38.0",
    "cache-manager": "^6.3.0",
    "cache-manager-redis": "^0.6.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.9",
    "hono-pino-logger": "^1.0.0",
    "ioredis": "^5.4.2",
    "memory-cache": "^0.2.0",
    "micro-packed": "^0.6.3",
    "node-cache": "^5.1.2",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.4",
    "prom-client": "^15.1.3",
    "react-use-websocket": "^4.8.1",
    "redis": "^4.7.0",
    "redis-semaphore": "^5.6.1",
    "remeda": "^2.19.1",
    "slot-watch-common": "workspace:*",
    "vitest": "^2.1.2",
    "zod": "^3.23.8"
  }
}
