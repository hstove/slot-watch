{
  "name": "slot-watch-api",
  "module": "src/run.ts",
  "type": "module",
  "exports": {
    ".": "./dist/app.js"
  },
  "types": "./dist/app.d.ts",
  "scripts": {
    "dev": "bun src/app.ts",
    "dev:watch": "bun --watch src/app.ts",
    "build": "tsup",
    "start": "bun src/app.ts",
    "typecheck": "tsc --noEmit",
    "generate-migrations": "drizzle-kit generate",
    "migrate": "bun migrate.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.27.0",
    "ts-toolbelt": "^9.6.0",
    "tsx": "^4.19.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@clarigen/core": "^2.1.2",
    "@hono/zod-validator": "^0.4.1",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.9",
    "@stacks/stacks-blockchain-api-types": "^7.14.1",
    "@stacks/transactions": "^6.16.1",
    "@stricjs/app": "^1.0.0-rc.34",
    "@stricjs/utils": "^2.0.7",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.8",
    "memory-cache": "^0.2.0",
    "micro-packed": "^0.6.3",
    "node-cache": "^5.1.2",
    "pg": "^8.13.0",
    "postgres": "^3.4.4",
    "react-use-websocket": "^4.8.1",
    "slot-watch-common": "workspace:*",
    "vitest": "^2.1.2"
  }
}
