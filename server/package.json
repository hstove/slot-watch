{
  "name": "slot-watch-api",
  "module": "src/server.ts",
  "main": "src/server.ts",
  "type": "module",
  "exports": {
    ".": "./dist/exports.js"
  },
  "types": "./dist/exports.d.ts",
  "scripts": {
    "dev:watch": "bun --watch src/app.ts",
    "build": "tsup",
    "start": "bun src/app.ts",
    "typecheck": "tsc --noEmit",
    "generate-migrations": "drizzle-kit generate",
    "migrate": "bun migrate.ts",
    "test:watch": "vitest",
    "dev": "wrangler dev --config ../server-wrangler.jsonc",
    "dev:remote": "wrangler dev --remote --config ../server-wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --config ../server-wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.34",
    "@cloudflare/workers-types": "^4.20250529.0",
    "@types/bun": "1.2.2",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.1",
    "ts-toolbelt": "^9.6.0",
    "tsx": "^4.19.1",
    "wrangler": "^4.18.0"
  },
  "peerDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@clarigen/boot": "^2.1.2",
    "@clarigen/core": "^2.1.2",
    "@hono/zod-validator": "^0.4.1",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.9",
    "@stacks/common": "^7.0.2",
    "@stacks/stacks-blockchain-api-types": "^7.14.1",
    "@stacks/transactions": "^7.0.2",
    "@stricjs/app": "^1.0.0-rc.34",
    "@stricjs/utils": "^2.0.7",
    "@upstash/redis": "^1.34.9",
    "alchemy": "^0.22.3",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "drizzle-orm": "^0.44.1",
    "eventsource": "^3.0.5",
    "eventsource-client": "^1.1.3",
    "hono": "4.7.11",
    "loglayer": "^6.4.2",
    "memory-cache": "^0.2.0",
    "micro-packed": "^0.6.3",
    "node-cache": "^5.1.2",
    "p-all": "^5.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "react-use-websocket": "^4.8.1",
    "remeda": "^2.19.1",
    "slot-watch-common": "workspace:*",
    "uuid": "^11.1.0",
    "vitest": "^2.1.2",
    "zod": "^3.23.8"
  }
}
