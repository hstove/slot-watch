{
  "name": "slot-watch-api",
  "main": "src/server.ts",
  "type": "module",
  "exports": {
    ".": "./src/exports.ts"
  },
  "scripts": {
    "dev:watch": "bun --watch src/app.ts",
    "build": "tsdown",
    "start": "bun src/app.ts",
    "typecheck": "tsgo --noEmit",
    "generate-migrations": "drizzle-kit generate",
    "migrate": "bunx --bun drizzle-kit migrate",
    "test:watch": "vitest",
    "dev": "wrangler dev --config ../server-wrangler.jsonc --host 0.0.0.0",
    "dev:tee": "unbuffer bun dev | tee tmp/dev-server.log",
    "dev:remote": "wrangler dev --remote --config ../server-wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --config ../server-wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.34",
    "@cloudflare/workers-types": "^4.20250529.0",
    "@types/bun": "1.2.2",
    "@types/pg": "^8.11.10",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.1",
    "ts-toolbelt": "^9.6.0",
    "wrangler": "^4.18.0"
  },
  "peerDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@clarigen/boot": "3.0.0",
    "@clarigen/core": "3.0.0",
    "@effect/platform": "^0.94.1",
    "@hono/standard-validator": "^0.2.1",
    "@hono/zod-validator": "^0.4.1",
    "@scalar/hono-api-reference": "^0.9.30",
    "@scure/base": "^1.1.9",
    "@stacks/network": "^7.0.2",
    "@stacks/stacks-blockchain-api-types": "^7.14.1",
    "@stacks/transactions": "^7.0.2",
    "@upstash/redis": "^1.34.9",
    "cloudflare": "^4.4.1",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "drizzle-orm": "^0.44.1",
    "effect": "^3.19.14",
    "eventsource-client": "^1.1.3",
    "hono": "4.7.11",
    "hono-openapi": "^1.1.2",
    "loglayer": "^6.4.2",
    "micro-packed": "^0.6.3",
    "p-all": "^5.0.0",
    "pg": "^8.16.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "remeda": "^2.19.1",
    "slot-watch-common": "workspace:*",
    "uuid": "^11.1.0",
    "vitest": "^2.1.2",
    "zod": "^3.23.8"
  }
}
