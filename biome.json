{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "maxSize": 2000000
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": [
      "**",
      "!**/node_modules/**",
      "!dist/**",
      "!server/drizzle/meta/**",
      "!routeTree.gen.ts",
      "!.turbo/**",
      "!.beads/**",
      "!common/src/stacks-rpc-types.d.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "style": {
        "useBlockStatements": "off",
        "useTrimStartEnd": "off",
        "useConsistentTypeDefinitions": "on"
      },
      "performance": {
        "noNamespaceImport": "off"
      },
      "suspicious": {
        "useIterableCallbackReturn": "off",
        "noArrayIndexKey": "off"
      },
      "correctness": {
        "noUnusedImports": "off",
        "noUnusedVariables": "off"
      },
      "nursery": "off"
    },
    "includes": [
      "**",
      "!**/node_modules/",
      "!dist/",
      "!server/drizzle/meta",
      "!routeTree.gen.ts",
      "!.turbo",
      "!common/src/stacks-rpc-types.d.ts"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["*.ts", "*.tsx"]
    },
    {
      "includes": ["tools/src/routes/**/*.ts", "tools/src/routes/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off",
        "useSortedAttributes": "off",
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "extends": ["ultracite/core", "ultracite/react"]
}
