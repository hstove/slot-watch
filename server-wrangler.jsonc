{
  "name": "slot-watch-worker",
  "main": "server/src/server.ts",
  "compatibility_date": "2025-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "STREAMER_URL": "https://slot-watch-streamer.fly.dev"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "4d65a9f9771f4b2d8887dc2c89cf766f",
      "preview_id": "4d65a9f9771f4b2d8887dc2c89cf766f"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MINER_COMMITS",
        "class_name": "MinerCommitsWatcher",
        "script_name": "slot-watch-worker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MinerCommitsWatcher"],
      "new_classes": []
    }
  ],
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "0d80e28aec7241daa9692ec6f7d0e409"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
